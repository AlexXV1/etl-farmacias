# Plantilla de configuración. Copiar a .env y reemplazar TODOS los valores "cambiar_...".
# La forma recomendada es:  .\.venv\Scripts\python.exe scripts\generar_env.py
# .env nunca se versiona (está en .gitignore).

# --- Docker / Airflow ---
AIRFLOW_UID=50000
# Clave para cifrar Connections y Variables en la base de Airflow.
FERNET_KEY=cambiar_fernet_key
# Firma de los tokens internos entre los componentes de Airflow 3.
AIRFLOW_JWT_SECRET=cambiar_jwt_secret

# Usuario administrador de la UI de Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_password_admin

# --- PostgreSQL (superusuario del contenedor + metadatos de Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=cambiar_password_postgres
POSTGRES_DB=airflow

# --- Base de datos del proyecto (rol de aplicación, sin superusuario) ---
FARMACIAS_DB_NAME=farmacias
FARMACIAS_DB_USER=etl_farmacias
FARMACIAS_DB_PASSWORD=cambiar_password_etl

# Connection de Airflow 'farmacias_pg' definida por variable de entorno.
# Debe coincidir con los valores anteriores; el host es el nombre del servicio docker.
AIRFLOW_CONN_FARMACIAS_PG=postgresql://etl_farmacias:cambiar_password_etl@postgres:5432/farmacias

# Acceso desde el host (scripts locales).
FARMACIAS_DB_HOST=127.0.0.1
FARMACIAS_DB_PORT=5433
